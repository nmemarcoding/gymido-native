# Copy this file to .env.development (and .env.staging / .env.production as needed).
# The APP_ENV set by the npm scripts decides which file app.config.js reads.
#
# Everything here is compiled into the app binary and is NOT secret.
# Never put a client secret, API key with write access, or any other secret here.
#
# For now there is one backend and one Auth0 tenant (gymido-dev) for every environment.

# Gymido backend API (Go)
API_BASE_URL=https://workoutapi.nimamemarzadeh.com

# Auth0 Native application "Gymido Native (iOS/Android)".
# Changing AUTH0_DOMAIN requires a native rebuild (it is baked in by the config plugin).
AUTH0_DOMAIN=gymido-dev.us.auth0.com
AUTH0_CLIENT_ID=EKQmmt4kdgegYfmfVCsUiAd6DT7XlLya
AUTH0_AUDIENCE=https://api.gymido
